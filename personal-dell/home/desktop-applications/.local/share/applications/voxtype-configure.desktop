[Desktop Entry]
Type=Application
Name=Voxtype Configuration
GenericName=Voice-to-Text Settings
Comment=Configure voxtype dictation settings (engine, model, hotkey, audio, output)
Exec=ghostty --gtk-single-instance=false --class=voxtype -e voxtype configure
Icon=audio-input-microphone
Categories=Settings;
Keywords=voxtype;voice;dictation;transcription;whisper;parakeet;settings;configuration;
Terminal=false
StartupWMClass=voxtype
