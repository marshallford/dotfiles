[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = limine

[Action]
Description = Deploying Limine after upgrade...
When = PostTransaction
Exec = /bin/sh -c '/usr/bin/cp /usr/share/limine/BOOTX64.EFI /boot/EFI/limine/ && { ! [ -f /var/lib/sbctl/GUID ] || /usr/bin/sbctl sign -s /boot/EFI/limine/BOOTX64.EFI; }'
