# Aliases
alias updater='brew update && brew upgrade'
alias cleaner='brew autoremove && brew cleanup'

# GlobalProtect VPN functions, from the vpn package
[[ -r ~/.config/zsh/vpn.zsh ]] && source ~/.config/zsh/vpn.zsh

# CLI Setup
[[ -s $HOMEBREW_PREFIX/opt/nvm/nvm.sh ]] && source "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
