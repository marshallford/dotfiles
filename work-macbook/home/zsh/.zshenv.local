export DOTFILES_MACHINE='work-macbook'

# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"
export HOMEBREW_BUNDLE_FILE="$DOTFILES/work-macbook/Brewfile"

export ANTIDOTE_FUNCTIONS="$HOMEBREW_PREFIX/share/antidote/functions"

# PATH
[[ -d $HOMEBREW_PREFIX/opt/rustup/bin ]] && path=($HOMEBREW_PREFIX/opt/rustup/bin $path) # keg-only, Homebrew links rustup but not the cargo/rustc proxies
